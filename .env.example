# BugShield configuration
# Copy to .env and fill in. Never commit .env.

# ---- server ----
PORT=3000
NODE_ENV=development

# ---- persistent storage ----
# All state (SQLite database, cloned repositories, mail outbox) lives here.
# On Render this MUST point at a mounted disk, e.g. /var/data, otherwise every
# restart destroys users, sessions, history and the audit trail.
# BUGSHIELD_DATA_DIR=/var/data

# ---- browser origins ----
# Comma-separated list of origins allowed to make credentialed requests.
# In production anything not listed is refused.
# The SDK on a customer's site does NOT need to be listed for issue ingestion,
# but the dashboard origin must be if it is served separately.
ALLOWED_ORIGINS=

# ---- bootstrap owner (created once, on first run only) ----
BOOTSTRAP_OWNER_EMAIL=owner@bugshield.local
# Leave unset to have a strong random password generated and printed once.
# BOOTSTRAP_OWNER_PASSWORD=

# ---- session cookie ----
# Set Secure=true only when serving over HTTPS.
# COOKIE_SECURE=false

# ---- outbound mail (member invitations) ----
# Without these, invitations produce a one-time activation link to share
# instead of sending an email, and the UI reports that honestly.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BugShield <no-reply@bugshield.local>

# ---- GitHub (repository integration) ----
# Preferred: GitHub App installation credentials
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM private key, with \n for newlines
GITHUB_APP_PRIVATE_KEY=
# Development only
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---- GitLab (planned, not implemented) ----
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# ---- CI/CD ----
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB=
JENKINS_CRUMB_TOKEN=
GITHUB_REPOSITORY=

# ---- deployment health checks ----
# When unset, deployment reports that live traffic was NOT verified.
HEALTH_CHECK_URL=

# ---- universal AI (any bug class) ----
# Deterministic detectors cover 4 JS classes for free. Everything else
# (cosmetic, HTML/CSS, novel bugs) is assessed and patched by openrouter/free
# via OpenRouter: POST https://openrouter.ai/api/v1/chat/completions
# Get a key at https://openrouter.ai/keys, then set AI_API_KEY below.
# (Never commit .env — it is gitignored. On Render, paste the key as the
# AI_API_KEY env var instead.)
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/free
# AI_API_KEY=
# Leave AI_API_KEY unset and the platform honestly reports AI as not
# configured instead of faking it.
# AI_TEMPERATURE=0.2
# AI_TIMEOUT_MS=60000